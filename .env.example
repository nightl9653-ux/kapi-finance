# 复制为 `.env.local` 后填入真实值（勿提交 Git）。
#
# 合规 / 生产域名（Vercel → Settings → Domains 绑定自定义域后填写）：
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@919145.xyz
#
# 地域合规（Vercel 提供 x-vercel-ip-country；本地 dev 通常不拦截）
# GEO_BLOCK_ENABLED=true
# GEO_BLOCK_COUNTRIES=CU,IR,KP,SY,RU,BY
#
# Supabase：仅用云端项目，到 Dashboard → Project Settings → API 复制下面两项
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# 可选：AI 每日限额（Free / Plus 分档；未设置则用代码内默认值）
# 扫单次数写在 ai_usage.screenshot_count；勿使用已废弃的 SCAN_RECEIPT_DAILY_LIMIT
# FREE_SCAN_DAILY_LIMIT=5
# PLUS_SCAN_DAILY_LIMIT=20
# FREE_VOICE_DAILY_LIMIT=3
# PLUS_VOICE_DAILY_LIMIT=12
# FREE_ASSISTANT_DAILY_LIMIT=20
# PLUS_ASSISTANT_DAILY_LIMIT=80
# FREE_DREAM_VISUAL_DAILY_LIMIT=0
# PLUS_DREAM_VISUAL_DAILY_LIMIT=1
# FREE_DREAM_VISUAL_HQ_DAILY_LIMIT=0
# PLUS_DREAM_VISUAL_HQ_DAILY_LIMIT=1
# FREE_DREAM_STORY_DAILY_LIMIT=5
# PLUS_DREAM_STORY_DAILY_LIMIT=15
# FREE_DREAM_LOCALIZED_MEDIA_DAILY_LIMIT=5
# PLUS_DREAM_LOCALIZED_MEDIA_DAILY_LIMIT=15

# OpenAI 兼容网关（扫单 / 语音 / 小作文等共用）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://www.dmxapi.com/v1
# OPENAI_SCAN_MODEL=gpt-4o-mini
# 语音转写：DMX 默认组通常不含 whisper-1，勿盲目填 whisper-1；以控制台「语音转写」模型名为准
# OPENAI_TRANSCRIBE_MODEL=DMX文档中的转写模型名
# DMX_TRANSCRIBE_MODEL=同上（二选一即可）

# Plus 会员（Creem Checkout 外链；付款后由 /api/billing/creem-webhook 自动开通）
# Creem 商品「返回网址」建议填（兜底，按浏览器语言跳定价页）：
# https://kapi-finance.vercel.app/api/billing/checkout-return
# 从咔账定价页点购买时会自动带 success_url=/{locale}/pricing?checkout=success
# PLUS_PLAN_MONTHLY_CHECKOUT_URL=https://creem.io/payment/prod_xxx
# CREEM_WEBHOOK_SECRET=              # Creem → Developers → Webhook 签名密钥
# CREEM_API_KEY=creem_xxx            # Production moderation + API（test 用 creem_test_ 前缀）
# CREEM_PRODUCT_ID_MONTHLY=prod_xxx  # 可选：webhook 无 metadata 时按商品 ID 识别方案
# CREEM_PRODUCT_ID_IMAGES_20=prod_xxx
# CREEM_PRODUCT_ID_HQ_10=prod_xxx
# PLUS_PLAN_QUARTERLY_CHECKOUT_URL=https://...
# PLUS_PLAN_YEARLY_CHECKOUT_URL=https://...
# PLUS_PLAN_LIFETIME_CHECKOUT_URL=https://...
# SUPABASE_SERVICE_ROLE_KEY=   # webhook 入账必需
# BILLING_WEBHOOK_SECRET=       # POST /api/billing/webhook Authorization: Bearer <secret>

# AI 加量包（Plus 专用；Checkout 外链 + webhook 入账）
# CREDIT_PACK_IMAGES_20_CHECKOUT_URL=https://...
# CREDIT_PACK_HQ_10_CHECKOUT_URL=https://...
